# Copia este archivo a .env.local y rellena los valores de TU proyecto de Supabase.
# Ambos valores son PÚBLICOS (se incluyen en el bundle del navegador). La seguridad
# de los datos depende de las políticas RLS, no de ocultar estas claves.
#
# NUNCA pongas aquí la clave secreta (sb_secret_...) ni la service_role.

# Project Settings → Data API → Project URL
VITE_SUPABASE_URL=

# Project Settings → API Keys → Publishable key (sb_publishable_...)
# Si tu proyecto usa claves antiguas, puedes usar la "anon public" (eyJ...).
VITE_SUPABASE_PUBLISHABLE_KEY=

# Ruta base de publicación. "/" en local, Netlify o Cloudflare Pages.
# En GitHub Pages la define el workflow como "/<nombre-del-repositorio>/".
VITE_BASE=/

# Notificaciones push: clave PÚBLICA VAPID (npm run vapid:keys genera el par).
# La clave PRIVADA nunca va aquí: solo en los Secrets de GitHub (VAPID_PRIVATE_KEY).
VITE_VAPID_PUBLIC_KEY=
