{
  "name": "refrun",
  "private": true,
  "version": "1.0.0",
  "description": "REFRUN — reto de carrera para árbitros de hockey sobre patines",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run ocr:assets && tsc -b && vite build && node scripts/spa-fallback.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ocr": "vitest run --config vitest.ocr.config.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "ocr:assets": "node scripts/copy-ocr-assets.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:secrets",
    "dev:visual": "vite --config tests/visual/vite.config.ts",
    "ocr:fixtures": "node scripts/generate-ocr-fixtures.mjs",
    "vapid:keys": "web-push generate-vapid-keys",
    "notify": "tsx --tsconfig tsconfig.app.json src/server/notify/run.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1",
    "tesseract.js": "^6.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@eslint/js": "^9.39.5",
    "@resvg/resvg-js": "^2.6.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.6",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "web-push": "^3.6.7",
    "workbox-window": "^7.4.1"
  }
}
